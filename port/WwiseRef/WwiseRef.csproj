<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Reference renderer for the audio differential test: drives the game's own Wwise
    (EtG_Data/Plugins/AkSoundEngine.dll, Wwise 2017.2, x64) through its exported SWIG
    entry points and captures the mix of each test case to a WAV file.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>WwiseRef</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
