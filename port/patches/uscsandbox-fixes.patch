+using System.Text;
+using System.Text.Json;
+
+namespace USCSandbox.Processor
+{
+    /// <summary>
+    /// --dump: next to the decompiled text, writes every DX11 sub program as it was in the game (raw DXBC,
+    /// without Unity's header) plus a JSON with its keywords and the parameter layout Unity binds
+    /// (constant buffers with offsets, buffer slots, textures, samplers). Used by port/ShaderDiff to run
+    /// the original bytecode against the recompiled decompilation on the same inputs.
+    /// Layout: dir/variants.json, dir/NNN.dxbc
+    /// </summary>
+    public class VariantDumper
+    {
+        private readonly string _dir;
+        private readonly List<object> _variants = [];
+
+        public VariantDumper(string dir)
+        {
+            _dir = dir;
+            if (Directory.Exists(dir))
+                Directory.Delete(dir, true);
+            Directory.CreateDirectory(dir);
+        }
+
+        public void Add(int subShader, int pass, string passName, string stage, string[] keywords,
+            ShaderSubProgram subProg, ShaderParams param)
+        {
+            var file = $"{_variants.Count:D3}.dxbc";
+            var dxbc = ExtractDxbc(subProg.ProgramData);
+            if (dxbc != null)
+                File.WriteAllBytes(Path.Combine(_dir, file), dxbc);
+
+            var cbuffers = new List<ConstantBuffer>();
+            if (param.BaseConstantBuffer is { CBParams.Count: > 0 })
+                cbuffers.Add(param.BaseConstantBuffer);
+            cbuffers.AddRange(param.ConstantBuffers);
+
+            _variants.Add(new
+            {
+                subShader,
+                pass,
+                passName,
+                stage,
+                keywords,
+                dxbc = dxbc != null ? file : null,
+                cbuffers = cbuffers.Select(cb => new
+                {
+                    name = cb.Name,
+                    size = cb.UsedSize,
+                    @params = cb.CBParams.Select(p => new
+                    {
+                        name = p.ParamName,
+                        type = p.ParamType.ToString(),
+                        rows = p.Rows,
+                        columns = p.Columns,
+                        isMatrix = p.IsMatrix,
+                        arraySize = p.ArraySize,
+                        offset = p.Index,
+                    }),
+                    structs = cb.StructParams.Select(s => new { name = s.Name, offset = s.Index, s.ArraySize, s.Size }),
+                }),
+                cbufferBindings = param.ConstBindings.Select(b => new { name = b.Name, slot = b.Index }),
+                buffers = param.Buffers.Select(b => new { name = b.Name, slot = b.Index }),
