+        // "0.0#######" keeps at most 8 decimals: 1e-10 (the epsilon of the standard RGB->HSV code)
+        // came out as 0.0, turning every grey pixel's hue into 0/0 = NaN. Fall back to round-trip
+        // exponent notation whenever the short form would change the value.
+        private static string FormatFloat(float value)
+        {
+            string text = value.ToString("0.0#######", CultureInfo.InvariantCulture);
+            if (float.Parse(text, CultureInfo.InvariantCulture) == value || float.IsNaN(value) || float.IsInfinity(value))
+            {
+                return text;
+            }
+            return value.ToString("R", CultureInfo.InvariantCulture).Replace("E", "e");
+        }
+
         public override string ToString()
         {
             return ToString(false);
