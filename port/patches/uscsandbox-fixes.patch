+        // A render state value can name a material property ("Ref [_StencilVal]", "ZTest [_ZTest]");
+        // .val is then only its default, and writing just .val bakes that default in.
+        private static string? PropRef(AssetTypeValueField parent, string key)
+        {
+            var field = parent[$"{key}.name"];
+            // Unity stores "<noninit>" when the value is a plain number
+            return field.IsDummy || string.IsNullOrEmpty(field.AsString) || field.AsString == "<noninit>" ? null : field.AsString;
+        }
+
+        private static string StateValue(AssetTypeValueField parent, string key, object literal)
+        {
+            var prop = PropRef(parent, key);
+            return prop != null ? $"[{prop}]" : Convert.ToString(literal, CultureInfo.InvariantCulture)!;
+        }
+
+        private static bool AnyPropRef(AssetTypeValueField parent, params string[] keys)
+        {
+            return keys.Any(k => PropRef(parent, k) != null);
+        }
