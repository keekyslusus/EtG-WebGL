+        // Unity prefixes the DXBC container with its own header (5-6 bytes, +0x20 in newer versions)
+        private static byte[]? ExtractDxbc(byte[] data)
+        {
+            var magic = Encoding.ASCII.GetBytes("DXBC");
+            for (var i = 0; i + 32 <= data.Length; i++)
+            {
+                if (data.AsSpan(i, 4).SequenceEqual(magic))
+                {
+                    var size = BitConverter.ToInt32(data, i + 24);
+                    if (size <= 0 || i + size > data.Length)
+                        return null;
+                    return data.AsSpan(i, size).ToArray();
+                }
+            }
+            return null;
+        }
+    }
